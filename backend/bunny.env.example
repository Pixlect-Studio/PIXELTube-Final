# ============================================================
# PIXELTube backend — bunny.env.example
# Default environment template. Copy the REAL values in, then
# use ONE of these (never commit the filled-in file):
#
#   Vercel (production):
#     Project → Settings → Environment Variables → add each key,
#     OR create one variable named DATA_ENV and paste this whole
#     file (with real values) as its value.
#
#   Local runs (npm start):
#     Save as backend/data.env (gitignored, never committed).
# ============================================================

# --- Bunny Stream (uploads + CDN playback) ---
BUNNY_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOST=

# --- Firebase (login) — optional, falls back to the public web key ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# --- Behaviour ---
# Comma-separated list for cross-origin frontends; empty = allow all.
ALLOWED_ORIGINS=
# "true" → uploads require a valid Firebase ID token.
REQUIRE_AUTH=false
# Local server port only (ignored on Vercel).
PORT=3000
